# ============================================================
# 1% Healthy Habit — Auth backend environment variables
# ============================================================
#
# IMPORTANT:
# This file is documentation only. The current server loads this file
# only as a fallback when a local .env is missing. Therefore this file
# intentionally contains NO active KEY=value assignments.
#
# Local development:
#   Copy this file to server/.env and add your real values.
#
# Render deployment:
#   Set the values below in Render -> Environment Variables.
#   NEVER commit real secrets to this repository.
#
# Required/commonly used variables:
#   MONGODB_URI=<MongoDB Atlas connection string>
#   MONGODB_DB=client1
#   BREVO_API_KEY=<Brevo API key>
#   BREVO_SENDER_EMAIL=<verified Brevo sender email>
#   MAIL_FROM_NAME=<sender display name>
#   GMAIL_USER=<Gmail address for local SMTP fallback>
#   GMAIL_APP_PASSWORD=<Gmail app password for local SMTP fallback>
#   WHATSAPP_NUMBER=<recovery contact number>
#   FRONTEND_URL=<public frontend URL>
#   PUBLIC_BASE_URL=<public backend URL>
#   PORT=3000
#
# Teacher sign-in (shared secret — NOT a database account):
#   TEACHER_USERNAME=<your secret teacher username>
#   TEACHER_PASSWORD=<your secret teacher password>
#   TEACHER_LANDING=../Teacher's/index.html
#
# Do not put the actual teacher username/password, database credentials,
# API keys, or other secrets in this example file.