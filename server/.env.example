# ============================================================
# 1% Healthy Habit — Auth backend environment variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env to git (it's in .gitignore).
# ============================================================

# ============================================================
# HOSTING (Render + MongoDB Atlas + Resend)
# ============================================================
# When deploying to Render, set these in the Render dashboard under
# Environment Variables for the web service. Locally, copy this file
# to ".env" and fill in the values.

# MongoDB Atlas connection string. Format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Leave empty in dev to fall back to local JSON files (created in this
# folder on first signup).
MONGODB_URI=

# Database name within the Atlas cluster. Defaults to "client1" if unset.
MONGODB_DB=client1

# Resend API key — for sending real email via HTTPS (works on Render's
# free tier, which blocks outbound SMTP). Get one at
# https://resend.com/api-keys. Leave empty in dev to fall back to
# Gmail SMTP or to logging emails to stderr.
RESEND_API_KEY=

# The "from" address for Resend-sent emails. Use onboarding@resend.dev
# (the Resend sandbox sender) until you verify your own domain.
MAIL_FROM=onboarding@resend.dev

# "From" name shown in the recipient's inbox.
MAIL_FROM_NAME=the 1% Healthy Habit Team

# Set to 1 when deploying to Render. Optional; only affects logging.
RENDER=1

# ============================================================
# DEV-ONLY FALLBACKS (Gmail SMTP)
# ============================================================
# Used locally when RESEND_API_KEY is empty. Render's free tier blocks
# outbound SMTP so these don't work on hosted deploys.

# Your Gmail address (the one that will send the welcome + reset emails)
GMAIL_USER=your.email@gmail.com

# Your Gmail App Password (NOT your normal Gmail password).
# Get one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=replace_with_16_char_app_password

# WhatsApp number shown in the "no Gmail on file" recovery message.
WHATSAPP_NUMBER=+234 814 159 4944

# Where the FRONTEND lives (the Login page users see). Used in the
# welcome email body so the user has a clickable link to sign in.
# On Render, set this to your onrender.com URL.
FRONTEND_URL=http://localhost:3000

# The public URL where this backend is reachable.
PUBLIC_BASE_URL=http://localhost:3000

# Server port (default 3000; Render sets PORT automatically)
PORT=3000

# ============================================================
# TEACHER SIGN-IN (shared secret — not per-user)
# ============================================================
# There is exactly ONE principal / owner account, identified by this
# shared secret. Anyone who types these two values on the Sign In page
# is sent to the principal landing page below. Regular users who
# create an account through the public signup form land on USER_LANDING
# instead, regardless of whether they are teachers or students.
#
# IMPORTANT: Do NOT put placeholder teacher credentials here. The server
# may load this example file when no local .env exists, and placeholder
# values could override the real Render environment variables. Set these
# ONLY in your local .env or in Render's Environment Variables:
#   TEACHER_USERNAME=<your-secret-username>
#   TEACHER_PASSWORD=<your-secret-password>

# Where the principal (shared-secret user) is sent after sign-in.
TEACHER_LANDING=../Teacher's/index.html

# Where a regular user (created via the Sign Up form) is sent after sign-in.
USER_LANDING=../Students/index.html
