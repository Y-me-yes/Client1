# ============================================================
# 1% Healthy Habit — Auth backend environment variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env to git (it's in .gitignore).
# ============================================================

# Your Gmail address (the one that will send the welcome + reset emails)
GMAIL_USER=your.email@gmail.com

# Your Gmail App Password (NOT your normal Gmail password).
# Get one at: https://myaccount.google.com/apppasswords
# You need 2-Step Verification enabled on your Google account first.
# 16 characters, no spaces in the value (the page shows them with spaces
# for readability, but Gmail SMTP needs them stripped).
GMAIL_APP_PASSWORD=replace_with_16_char_app_password

# The "from" name that appears in the email
MAIL_FROM_NAME=the 1% Healthy Habit Team

# WhatsApp number shown in the "no Gmail on file" recovery message.
# Users with no Gmail on file are told to contact this number on WhatsApp.
WHATSAPP_NUMBER=+234 814 159 4944

# Where the FRONTEND lives (the Login page users see). Used in the welcome
# email body so the user has a clickable link to sign in.
# In dev, the static server picks 8001..8051 — adjust if yours
# is on a different port.
FRONTEND_URL=http://localhost:8001

# The public URL where this backend is reachable.
# In dev, leave it as localhost. When you deploy, change to your real URL.
PUBLIC_BASE_URL=http://localhost:3000

# Server port (default 3000)
PORT=3000

# ============================================================
# TEACHER SIGN-IN (shared secret — not per-user)
# ============================================================
# There is exactly ONE principal / owner account, identified by this
# shared secret. Anyone who types these two values on the Sign In page
# is sent to the principal landing page below. Regular users who
# create an account through the public signup form land on USER_LANDING
# instead, regardless of whether they are teachers or students.
#
# Set strong values in your .env. The placeholders below are what
# the server will read on startup; change them before going live.
TEACHER_USERNAME=replace_with_teacher_username
TEACHER_PASSWORD=replace_with_teacher_password

# Where the principal (shared-secret user) is sent after sign-in.
TEACHER_LANDING=../Teacher's/index.html

# Where a regular user (created via the Sign Up form) is sent after sign-in.
USER_LANDING=../Students/index.html
